# ==========================================
# MindZen ALCM / ITAM Environment Settings
# ==========================================

# Environment mode: 'development', 'test', or 'production'
# In 'production', secure database credentials and secure cookies are enforced.
APP_ENV=development

# Cookie security:
# In development (plain HTTP), set to false.
# In production (HTTPS deployment), this must be true (or omitted, which defaults to true).
# Attempting to set COOKIE_SECURE=false in production is rejected at startup.
COOKIE_SECURE=false

APP_TITLE=MindZen ALCM / ITAM
APP_VERSION=0.1.0

# Database connection:
# In production, use strong credentials; default/weak passwords ('change_me', etc.)
# are rejected at startup.
DATABASE_URL=postgresql+psycopg://mindzen:change_me@postgres:5432/mindzen

# Allowed CORS origins (comma-separated):
# In production, specify exact HTTPS domains; wildcard '*' is rejected.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

API_PREFIX=/api/v1
LOG_LEVEL=INFO
